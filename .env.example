# Copy to .env.local and fill in. Never commit real values.

# ── Voice interviews (required to run live interviews) ─────────────────────────
# Vapi PUBLIC key: dashboard.vapi.ai → Organization / API Keys → Public Key.
# It is designed to be used in the browser. In Vapi, restrict it to your site's
# domains. Never put your Vapi PRIVATE key here.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Optional overrides for the interviewer (defaults shown).
# Model must be one Vapi supports for provider "openai".
# NEXT_PUBLIC_VAPI_LLM_MODEL=gpt-4.1
# ElevenLabs voice ID used through Vapi.
# NEXT_PUBLIC_VAPI_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Feedback reports and question plans (server-side only) ─────────────────────
# Any OpenAI-compatible Chat Completions API. Without a key, interviews still run
# and transcripts are saved, but reports and personalised plans are unavailable.
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
